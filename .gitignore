# -----------------------------
# ML-ENGINE DATA PROTECTION
# -----------------------------
# Ignore raw resumes and processed artifacts to prevent PII leakage
ml-service/ml-engine/ml_engine/data/uploads/*
ml-service/ml-engine/ml_engine/data/processed/*
ml-service/ml-engine/ml_engine/data/results/*

# Allow .gitkeep files to maintain folder structure
!ml-service/ml-engine/ml_engine/data/uploads/.gitkeep
!ml-service/ml-engine/ml_engine/data/processed/.gitkeep
!ml-service/ml-engine/ml_engine/data/results/.gitkeep

# Ignore large ML artifacts and synthetic datasets
ml-service/ml-engine/ml_engine/ml/artifacts/*.joblib
ml-service/ml-engine/ml_engine/ml/datasets/*.csv
ml-service/ml-engine/ml_engine/ml/datasets/*.jsonl

# Ignore engine debug/demo cache
debug_extraction.py
ml-service/ml-engine/debug_extraction.py
ml-service/ml-engine/demo/uploads/
ml-service/ml-engine/demo/.streamlit/